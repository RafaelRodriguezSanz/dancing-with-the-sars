# Copy this file to .env (gitignored) and fill it in. Never commit .env.
# Earthdata Login token: https://urs.earthdata.nasa.gov -> Generate Token (valid 60 days).
# Needed to read NISAR GCOV granules (scripts/nisar_subset.py, scripts/serve.py).
# Alternatives: the EARTHDATA_TOKEN environment variable, or the token alone in ~/.earthdata_token.
EARTHDATA_TOKEN=

# Optional: days an area processed by scripts/serve.py is kept on disk after it was last opened (default 7).
# NISAR_CACHE_DAYS=7
